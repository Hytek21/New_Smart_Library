# Copy this file to .env and fill in real values. .env should NOT be committed.

# --- Email — sent via Resend's HTTP API, not SMTP (Render blocks/hangs
# outbound SMTP, which was crashing the server on login) ---
RESEND_API_KEY=your-resend-api-key
# onboarding@resend.dev works with no setup, for any recipient — fine for
# now. Switch to an address on your own verified domain later.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Arkesel SMS — for sending 2FA codes by text ---
ARKESEL_API_KEY=your-arkesel-api-key
ARKESEL_SENDER_ID=GCTULib
